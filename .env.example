# Copy this file to .env.local and fill it in (never commit .env.local).
# Spotify Client ID from https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=

# AI agents. Server-only: no VITE_ prefix, never sent to the browser.
# Pick ONE provider. With GEMINI_API_KEY set, Gemini is used unless AI_PROVIDER says otherwise.
# Gemini (free tier): get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash   # students can also pick one on the Planner page
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash   # used when the main model is busy
# Claude: get a key at https://platform.claude.com/ and set a monthly spend limit there.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# AI_PROVIDER=gemini   # or anthropic
